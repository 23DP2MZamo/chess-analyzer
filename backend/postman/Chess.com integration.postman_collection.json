{
  "info": {
    "_postman_id": "2f31d4ab-55da-4cf0-9050-f41af86d44b0",
    "name": "Chess Analyzer - Chess.com integration",
    "description": "Tests Chess.com account linking, archive import and persistence in the shared games table. Set the collection variables before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "identifier",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "chesscomUsername",
      "value": ""
    },
    {
      "key": "imported",
      "value": "0"
    },
    {
      "key": "skipped",
      "value": "0"
    }
  ],
  "item": [
    {
      "name": "1. Sign in",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{identifier}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/signin"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sign-in succeeds and establishes a session', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.cookies.has('connect.sid')).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Link Chess.com account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{chesscomUsername}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/accounts/chesscom"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Chess.com account is verified and linked', function () {",
              "    pm.response.to.have.status(201);",
              "    const account = pm.response.json();",
              "    pm.expect(account.platform).to.eql('CHESSCOM');",
              "    pm.expect(account.platformUsername.toLowerCase()).to.eql(pm.collectionVariables.get('chesscomUsername').toLowerCase());",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Import Chess.com games",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/games/chesscom/import"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Chess.com games are imported or correctly skipped', function () {",
              "    pm.response.to.have.status(201);",
              "    const result = pm.response.json();",
              "    pm.expect(result.imported).to.be.a('number');",
              "    pm.expect(result.skipped).to.be.a('number');",
              "    pm.expect(result.imported).to.be.at.least(0);",
              "    pm.expect(result.skipped).to.be.at.least(0);",
              "    pm.collectionVariables.set('imported', String(result.imported));",
              "    pm.collectionVariables.set('skipped', String(result.skipped));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Verify games are persisted",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/games"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Imported Chess.com games are present in the shared games table', function () {",
              "    pm.response.to.have.status(200);",
              "    const games = pm.response.json();",
              "    pm.expect(games).to.be.an('array');",
              "    const chessComGames = games.filter(function (game) { return game.platform === 'CHESSCOM'; });",
              "    const imported = Number(pm.collectionVariables.get('imported'));",
              "    const skipped = Number(pm.collectionVariables.get('skipped'));",
              "    pm.expect(imported + skipped, 'the Chess.com account should have public games').to.be.greaterThan(0);",
              "    pm.expect(chessComGames.length, 'at least one Chess.com game should be returned').to.be.greaterThan(0);",
              "    chessComGames.forEach(function (game) {",
              "        pm.expect(game.externalId).to.be.a('string').and.not.empty;",
              "        pm.expect(game.whiteUsername).to.be.a('string').and.not.empty;",
              "        pm.expect(game.blackUsername).to.be.a('string').and.not.empty;",
              "        pm.expect(game.playedAt).to.be.a('string').and.not.empty;",
              "    });",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
